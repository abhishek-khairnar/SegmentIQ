# Backend Environment Variables
DATABASE_URL=sqlite:///./segmentiq.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://segmentiq:segmentiq_pass@localhost:5432/segmentiq

SECRET_KEY=segmentiq-super-secret-key-change-in-production-min-32-chars-long!
ADMIN_EMAIL=admin@segmentiq.com
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_DIR=storage
COOKIE_SECURE=false

# Frontend Environment Variables (in frontend/.env.local if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
